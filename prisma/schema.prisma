generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USER
  ASISTENTE
  ADMIN
}

enum EstadoCaja {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum EstadoSorteo {
  PENDIENTE
  EN_CURSO
  ACTIVO
  FINALIZADO
}

enum TipoSorteo {
  PRINCIPAL
  GRAN_SORTEO
}

enum CategoriaPremio {
  CUATRO_CIFRAS
  TRES_CIFRAS
  DOS_CIFRAS
  UNA_CIFRA
}

enum EstadoRetiro {
  PENDIENTE
  PRE_APROBADO
  APROBADO
  RECHAZADO
  PAGADO
}

enum EstadoGiftCard {
  DISPONIBLE
  USADA
  RETIRADA
  REGALADA
}

enum TipoTransaccion {
  COMPRA
  PREMIO
  RETIRO
  RECARGA
}

enum EstadoPagoManual {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoPagoBold {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id              String        @id @default(cuid())
  nombre          String
  apellido        String
  documento       String        @unique
  correo          String        @unique
  celular         String
  ciudad          String
  departamento    String
  fechaNacimiento DateTime?
  cuentaBancaria  String?
  banco           String?
  tipoCuenta      String?
  whatsapp        String?
  avatar          String?
  password        String
  rol             Rol           @default(USER)
  saldoPuntos     Float         @default(0)
  activo          Boolean       @default(true)
  confirmado      Boolean       @default(false)
  eliminado       Boolean       @default(false)
  eliminadoEn     DateTime?
  fechaRegistro   DateTime      @default(now())
  codigoRef          String?       @unique
  resetToken         String?       @unique
  resetTokenExpiry   DateTime?
  resetSolicitadoEn  DateTime?
  loginIntentos      Int           @default(0)
  bloqueadoHasta     DateTime?
  verifyToken        String?       @unique
  verifyTokenExpiry  DateTime?
  twoFactorCode      String?
  twoFactorExpiry    DateTime?
  sessionVersion     Int           @default(0)

  cajas           Caja[]
  transacciones   Transaccion[]
  premios         Premio[]
  ganadoresPublicos GanadorPublico[]
  retiros         Retiro[]
  referidosHechos    Referido[] @relation("Referidor")
  referidoRegistrado Referido?  @relation("Referido")
  cupones            Cupon[]
  giftCards          GiftCard[]
  auditLogs          AuditLog[]
  notificaciones     Notificacion[]
  notifLecturas      NotifLectura[]
  notifReacciones    NotifReaccion[]
  notifEliminadas    NotifEliminada[]
  conversaciones     ChatConversacion[] @relation("ConversacionesUsuario")
  conversacionesAsesor ChatConversacion[] @relation("ConversacionesAsesor")
  pagosManuals       PagoManual[] @relation("PagoUsuario")
  pagosAprobados     PagoManual[] @relation("PagoAprobador")
  pagosBold          PagoBold[]

  @@map("users")
}

model Referido {
  id          String    @id @default(cuid())
  referidorId String
  referidoId  String    @unique
  fecha       DateTime  @default(now())
  compro      Boolean   @default(false)

  referidor   User     @relation("Referidor", fields: [referidorId], references: [id])
  referido    User     @relation("Referido", fields: [referidoId], references: [id])

  @@map("referidos")
}

model Cupon {
  id            String    @id @default(cuid())
  usuarioId     String
  codigo        String    @unique
  usado         Boolean   @default(false)
  fechaCreacion DateTime  @default(now())
  fechaUso      DateTime?

  usuario       User      @relation(fields: [usuarioId], references: [id])

  @@map("cupones")
}

model GiftCard {
  id            String         @id @default(cuid())
  codigo        String         @unique
  valor         Float
  estado        EstadoGiftCard @default(DISPONIBLE)
  propietarioId String
  creadaEn      DateTime       @default(now())
  usadaEn       DateTime?
  nota          String?

  propietario   User           @relation(fields: [propietarioId], references: [id])

  @@map("gift_cards")
}

model Caja {
  id              String         @id @default(cuid())
  numero          String
  estado          EstadoCaja     @default(DISPONIBLE)
  userId          String?
  fechaCompra     DateTime?
  idCompra        String?
  tipoSorteo      TipoSorteo     @default(PRINCIPAL)
  granSorteoId    String?
  tipoMembresiaId String?

  user            User?          @relation(fields: [userId], references: [id])
  granSorteo      GranSorteo?    @relation(fields: [granSorteoId], references: [id])
  tipoMembresia   TipoMembresia? @relation(fields: [tipoMembresiaId], references: [id])

  @@unique([tipoMembresiaId, numero], name: "cajaTierNumero")
  @@map("cajas")
}

// Cada membresía independiente (10k/25k/50k) — su propio pool de 10,000
// números, su propia selección aleatoria/temporada y su propio calendario.
model TipoMembresia {
  id              String    @id @default(cuid())
  slug            String    @unique
  nombre          String
  precio          Float
  activo          Boolean   @default(true)
  fechaSorteo     DateTime?
  linkPagoBoldUrl String?
  orden           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cajas             Caja[]
  sorteos           Sorteo[]
  temporadas        Temporada[]
  ganadoresPublicos GanadorPublico[]
  pagosManuales     PagoManual[]
  pagosBold         PagoBold[]

  @@map("tipos_membresia")
}

model Transaccion {
  id           String          @id @default(cuid())
  userId       String
  tipo         TipoTransaccion
  monto        Float
  descripcion  String
  fecha        DateTime        @default(now())
  referencia   String?
  granSorteoId String?

  user         User            @relation(fields: [userId], references: [id])
  granSorteo   GranSorteo?     @relation(fields: [granSorteoId], references: [id])

  @@map("transacciones")
}

model Sorteo {
  id               String         @id @default(cuid())
  fecha            DateTime
  numeroGanador    String?
  numerosGanadores Json?
  estado           EstadoSorteo   @default(PENDIENTE)
  totalVendidas    Int            @default(0)
  totalRecaudo     Float          @default(0)
  ganancia         Float          @default(0)
  fondoPremios     Float          @default(0)
  configuracion    Json?
  temporadaId      String?
  tipoMembresiaId  String?

  premios          Premio[]
  temporada        Temporada?     @relation(fields: [temporadaId], references: [id])
  tipoMembresia    TipoMembresia? @relation(fields: [tipoMembresiaId], references: [id])

  @@map("sorteos")
}

// Ciclo recurrente de venta de las 10,000 membresías. Se abre una temporada
// nueva automáticamente cada vez que se ejecuta la selección principal — las
// membresías vuelven a DISPONIBLE y arranca el conteo desde cero.
model Temporada {
  id              String         @id @default(cuid())
  tipoMembresiaId String
  numero          Int
  inicio          DateTime       @default(now())
  fin             DateTime?
  totalVendidas   Int?
  totalRecaudo    Float?
  fondoPremios    Float?
  ganancia        Float?

  tipoMembresia     TipoMembresia    @relation(fields: [tipoMembresiaId], references: [id])
  sorteos           Sorteo[]
  ganadoresPublicos GanadorPublico[]

  @@unique([tipoMembresiaId, numero])
  @@map("temporadas")
}

model Premio {
  id         String          @id @default(cuid())
  sorteoId   String
  userId     String
  categoria  CategoriaPremio
  monto      Float
  pagado     Boolean         @default(false)
  numeroCaja String?

  sorteo     Sorteo          @relation(fields: [sorteoId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@map("premios")
}

// Feed unificado de ganadores para el ranking público — se alimenta desde los
// 4 mecanismos de sorteo (Sorteo principal, Gran Sorteo, Sorteo Previo, Selección
// Anticipada), cada uno con su propio modelo/lógica de premios internos.
model GanadorPublico {
  id              String         @id @default(cuid())
  userId          String
  numeroCaja      String?
  monto           Float?
  categoria       String
  origen          String
  fecha           DateTime       @default(now())
  temporadaId     String?
  tipoMembresiaId String?

  user            User           @relation(fields: [userId], references: [id])
  temporada       Temporada?     @relation(fields: [temporadaId], references: [id])
  tipoMembresia   TipoMembresia? @relation(fields: [tipoMembresiaId], references: [id])

  @@map("ganadores_publicos")
}

model Retiro {
  id                  String       @id @default(cuid())
  userId              String
  monto               Float
  estado              EstadoRetiro @default(PENDIENTE)
  cuentaDestino       String
  fecha               DateTime     @default(now())

  preAprobadoPorId    String?
  preAprobadoEn       DateTime?
  retencion           Float?
  porcentajeRetencion Float?
  notaRetencion       String?
  montoNeto           Float?

  motivoRechazo       String?
  retencionDetalle    Json?

  confirmado          Boolean   @default(false)
  confirmacionToken   String?
  confirmacionExpiry  DateTime?

  user                User         @relation(fields: [userId], references: [id])

  @@map("retiros")
}

model Config {
  id               String    @id @default("singleton")
  precioCaja       Float     @default(10000)
  margenGanancia   Float     @default(0.30)
  pct4Cifras       Float     @default(0.20)
  pct3Cifras       Float     @default(0.10)
  pct2Cifras       Float     @default(0.15)
  pct1Cifra        Float     @default(0.25)
  ganadores4Cifras       Int       @default(4)
  membresiasPorGiftCard  Int       @default(5)
  giftCardActivo         Boolean   @default(true)
  fechaSorteo            DateTime?
  updatedAt        DateTime  @updatedAt
  qrPagoUrl        String?   @default("")
  brebKey          String?   @default("")
  datosBancarios   String?   @default("")
  linkPagoBoldUrl  String?   @default("")
  saldoGiftCardActivo Boolean @default(false)
  retirosDisponiblesDesde DateTime?

  @@map("config")
}

enum EstadoAnticipada {
  PENDIENTE
  EJECUTADO
}

model SorteoAnticipado {
  id                String           @id @default(cuid())
  nombre            String
  descripcion       String?
  premioDescripcion String
  premioValor       Float?
  cantidadGanadores Int              @default(5)
  soloVendidas      Boolean          @default(true)
  minCajas          Int              @default(0)
  fecha             DateTime
  estado            EstadoAnticipada @default(PENDIENTE)
  ganadores         Json?

  @@map("sorteos_anticipados")
}


model GranSorteo {
  id                  String             @id @default(cuid())
  nombre              String
  descripcion         String
  premioDescripcion   String
  valorCaja           Int
  fechaInicio         DateTime
  fechaSorteo         DateTime
  numeroGanador       String?
  estado              EstadoSorteo       @default(ACTIVO)
  recaudo             Int                @default(0)
  fondoPremios        Int                @default(0)
  ganancia            Int                @default(0)
  distribucionPremios Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  cajas               Caja[]
  sorteosPrevios      SorteoPrevioGran[]
  transacciones       Transaccion[]

  @@map("grandes_sorteos")
}

model SorteoPrevioGran {
  id                String       @id @default(cuid())
  granSorteoId      String
  nombre            String
  premioDescripcion String
  premioValor       Int?
  fechaSorteo       DateTime
  cantidadGanadores Int          @default(5)
  requisitos        Json
  ganadores         Json?
  estado            EstadoSorteo @default(ACTIVO)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  granSorteo        GranSorteo   @relation(fields: [granSorteoId], references: [id])

  @@map("sorteos_previos_gran")
}

model Notificacion {
  id           String         @id @default(cuid())
  tipo         String         // SISTEMA | SORTEO | RETIRO | PROMO | MEMBRESIA
  titulo       String
  cuerpo       String
  icono        String         @default("🔔")
  usuarioId    String?        // null = broadcast
  paraAdmins   Boolean        @default(false)
  paraUsuarios Boolean        @default(false)
  createdAt    DateTime       @default(now())

  lecturas     NotifLectura[]
  reacciones   NotifReaccion[]
  eliminadas   NotifEliminada[]
  usuario      User?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("notificaciones")
}

model NotifReaccion {
  notificacionId String
  usuarioId      String
  emoji          String
  createdAt      DateTime     @default(now())

  notificacion   Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario        User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([notificacionId, usuarioId])
  @@map("notif_reacciones")
}

model NotifLectura {
  notificacionId String
  usuarioId      String
  leidaEn        DateTime     @default(now())

  notificacion   Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario        User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([notificacionId, usuarioId])
  @@map("notif_lecturas")
}

// Notificacion "eliminada" desde la bandeja de UN usuario — no borra el
// registro global (una notificacion broadcast la siguen viendo los demas).
model NotifEliminada {
  notificacionId String
  usuarioId      String
  eliminadaEn    DateTime     @default(now())

  notificacion   Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario        User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([notificacionId, usuarioId])
  @@map("notif_eliminadas")
}

enum EstadoConversacion {
  BOT              // el bot está respondiendo con FAQs
  ESPERANDO_ASESOR // el usuario pidió hablar con alguien, nadie la ha tomado
  EN_ATENCION      // un admin/asistente la tomó y está respondiendo en vivo
  CERRADA
}

enum AutorMensaje {
  USER
  BOT
  ADMIN
}

// Pregunta frecuente que el bot puede reconocer y responder. Administrable
// desde /admin/chats/faqs — no está hardcodeada en el código.
model FaqItem {
  id           String   @id @default(cuid())
  categoria    String
  pregunta     String
  palabrasClave String[] @default([])
  respuesta    String
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoria])
  @@map("faq_items")
}

model ChatConversacion {
  id          String             @id @default(cuid())
  usuarioId   String
  usuario     User               @relation("ConversacionesUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  estado      EstadoConversacion @default(BOT)
  escalada    Boolean            @default(false) // true en cuanto se pidió un asesor alguna vez
  asesorId    String?
  asesor      User?              @relation("ConversacionesAsesor", fields: [asesorId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  mensajes    ChatMensaje[]

  @@index([usuarioId])
  @@index([estado])
  @@index([escalada])
  @@map("chat_conversaciones")
}

model ChatMensaje {
  id               String           @id @default(cuid())
  conversacionId   String
  conversacion     ChatConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor            AutorMensaje
  autorId          String?
  contenido        String
  leidoPorUsuario  Boolean          @default(false)
  leidoPorAdmin    Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([conversacionId])
  @@map("chat_mensajes")
}

model ConceptoRetencion {
  id         String   @id @default(cuid())
  nombre     String
  porcentaje Float
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("conceptos_retencion")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  accion   String
  detalle  String?
  ip       String?
  fecha    DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([fecha])
  @@map("audit_logs")
}

model PagoManual {
  id              String           @id @default(cuid())
  referencia      String           @unique
  usuarioId       String
  numeroCaja      String
  tipoMembresiaId String?
  monto          Float
  nombrePagador  String
  refBancaria    String
  comprobanteUrl String?
  notas          String?
  estado         EstadoPagoManual @default(PENDIENTE)
  motivoRechazo  String?
  aprobadoPorId  String?
  aprobadoEn     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  usuario    User  @relation("PagoUsuario",   fields: [usuarioId],    references: [id])
  aprobadoPor User? @relation("PagoAprobador", fields: [aprobadoPorId], references: [id])
  tipoMembresia TipoMembresia? @relation(fields: [tipoMembresiaId], references: [id])

  @@map("pagos_manuales")
}

model PagoBold {
  id              String         @id @default(cuid())
  orderId         String         @unique
  usuarioId       String
  numeroCaja      String
  numerosCaja     String[]       @default([])
  tipoMembresiaId String?
  monto           Float
  moneda          String         @default("COP")
  estado          EstadoPagoBold @default(PENDIENTE)
  paymentId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  usuario         User           @relation(fields: [usuarioId], references: [id])
  tipoMembresia   TipoMembresia? @relation(fields: [tipoMembresiaId], references: [id])

  @@index([usuarioId])
  @@map("pagos_bold")
}

